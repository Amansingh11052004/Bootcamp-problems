class Solution {
    public boolean canJump(int[] nums) {
        int n = nums.length;
        int maxIdx = 0;
        if(n == 1){
            if(nums[0] == 0) return true;
        }
        for(int i=0; i<=maxIdx; i++){
            int sum = nums[i] + i;
            if(sum > maxIdx){
                maxIdx = sum;
            }
            if(maxIdx >= n-1) return true;
        }
        
        return false;
    }
}
