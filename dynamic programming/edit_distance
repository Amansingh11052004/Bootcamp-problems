class Solution {
    public int minDistance(String word1, String word2) {
        int n = word1.length();
        int m = word2.length();
        int[][] dp = new int[n+1][m+1];
        for(int i=0; i<n; i++){
            Arrays.fill(dp[i], -1);
        }
        return helper(0, 0, word1, word2, dp);
    }
    public int helper(int i, int j, String a, String b, int[][] dp){
        if(i == a.length()) return b.length() - j;
        if(j == b.length()) return a.length() - i;
        if(dp[i][j] != -1) return dp[i][j];

        int ans = 0;
        if(a.charAt(i) == b.charAt(j)){
            return dp[i][j] = helper(i+1, j+1, a, b, dp);
        }
        else{
            int insert = 1 + helper(i, j+1, a, b, dp);
            int delete = 1 + helper(i+1, j, a, b, dp);
            int replace = 1 + helper(i+1, j+1, a, b, dp);
            ans = Math.min(insert, Math.min(delete, replace));
        }
        return dp[i][j] = ans;
    }
}
