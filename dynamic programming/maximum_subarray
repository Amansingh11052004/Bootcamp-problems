class Solution {
    public int maxSubArray(int[] nums) {
        int n = nums.length;
        int i = 0;
        int fmax = nums[0];   
        if(n == 1) return nums[0];
        while(i < n){
            if(nums[i] > 0){
               int sum = 0;
               int max = nums[i];   
               
               while(i < n && sum >= 0){
                  sum += nums[i];
                  max = Math.max(max, sum);
                  i++;
               }
               fmax = Math.max(fmax, max);
            }
            else{
                fmax = Math.max(fmax, nums[i]); 
                i++;
            }
        }
        return fmax;
    }
}
